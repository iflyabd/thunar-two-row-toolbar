+/* BEGIN two-row toolbar patch */
+
+
+
+/* move all items of the second toolbar row back into the first row */
+static void
+thunar_window_location_toolbar_merge_rows (ThunarWindow *window)
+{
+  GList *children;
+  GList *lp;
+
+  if (window->location_toolbar2 == NULL)
+    return;
+
+  children = gtk_container_get_children (GTK_CONTAINER (window->location_toolbar2));
+  for (lp = children; lp != NULL; lp = lp->next)
+    {
+      GtkWidget *item = lp->data;
+
+      g_object_ref (item);
+      gtk_container_remove (GTK_CONTAINER (window->location_toolbar2), item);
+      gtk_toolbar_insert (GTK_TOOLBAR (window->location_toolbar), GTK_TOOL_ITEM (item), -1);
+      g_object_unref (item);
+    }
+  g_list_free (children);
+
+  gtk_widget_destroy (window->location_toolbar2);
+  window->location_toolbar2 = NULL;
+}
+
+
+
+/* move every item behind the location bar into a second toolbar row */
+static void
+thunar_window_location_toolbar_split_rows (ThunarWindow *window)
+{
+  GList     *children;
+  GList     *lp;
+  GtkWidget *toolbar2;
+  gboolean   after_location_bar = FALSE;
+  gboolean   small_icons;
+  gint       icon_size;
+
+  _thunar_return_if_fail (THUNAR_IS_WINDOW (window));
+
+  if (window->location_toolbar_box == NULL)
+    return;
+
+  if (window->location_toolbar2 != NULL)
+    thunar_window_location_toolbar_merge_rows (window);
+
+  g_object_get (G_OBJECT (window->preferences), "misc-small-toolbar-icons", &small_icons, NULL);
+  icon_size = small_icons ? GTK_ICON_SIZE_SMALL_TOOLBAR : GTK_ICON_SIZE_LARGE_TOOLBAR;
+
+  toolbar2 = gtk_toolbar_new ();
+  gtk_toolbar_set_style (GTK_TOOLBAR (toolbar2), GTK_TOOLBAR_ICONS);
+  gtk_toolbar_set_icon_size (GTK_TOOLBAR (toolbar2), icon_size);
+  gtk_widget_set_hexpand (toolbar2, TRUE);
+  g_signal_connect (G_OBJECT (toolbar2), "button-press-event", G_CALLBACK (thunar_window_toolbar_button_press_event), window);
+
+  children = gtk_container_get_children (GTK_CONTAINER (window->location_toolbar));
+  for (lp = children; lp != NULL; lp = lp->next)
+    {
+      GtkWidget *item = lp->data;
+      gchar     *id = g_object_get_data (G_OBJECT (item), "id");
+
+      /* the location bar marks the end of the first row */
+      if (g_strcmp0 (id, "location-bar") == 0)
+        {
+          after_location_bar = TRUE;
+          continue;
+        }
+
+      if (!after_location_bar)
+        continue;
+
+      g_object_ref (item);
+      gtk_container_remove (GTK_CONTAINER (window->location_toolbar), item);
+      gtk_toolbar_insert (GTK_TOOLBAR (toolbar2), GTK_TOOL_ITEM (item), -1);
+      g_object_unref (item);
+    }
+  g_list_free (children);
+
+  gtk_box_pack_start (GTK_BOX (window->location_toolbar_box), toolbar2, FALSE, FALSE, 0);
+  gtk_widget_show (toolbar2);
+
+  window->location_toolbar2 = toolbar2;
+}
+
+
+
+/* create the vertical box that holds the toolbar rows */
+static void
+thunar_window_location_toolbar_create_box (ThunarWindow *window)
+{
+  window->location_toolbar_box = gtk_box_new (GTK_ORIENTATION_VERTICAL, 0);
+  gtk_widget_set_hexpand (window->location_toolbar_box, TRUE);
+  gtk_box_pack_start (GTK_BOX (window->location_toolbar_box), window->location_toolbar, FALSE, FALSE, 0);
+  gtk_widget_show (window->location_toolbar);
+  gtk_widget_show (window->location_toolbar_box);
+}
+
+/* END two-row toolbar patch */
+
+
